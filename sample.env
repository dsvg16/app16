# Example .env file
# You should replace these values and rename this file .env
# published port, defaults to 5000. set 8000 on mac
HOST_PORT=5000
MARIADB_ROOT_PASSWORD=replace_with_a_long_random_password
MARIADB_USER=tatou
MARIADB_PASSWORD=replace_with_another_long_random_password
FLAG_2=replace_with_the_flag_from_ilearn
SECRET_KEY=replace_with_a_long_random_secret
# RMAP (Phase I): stable HMAC key for the watermark;
RMAP_WM_KEY=replace_with_a_long_random_secret
RMAP_KEY_PASSPHRASE=

# Optional paired RMAP relay exercise (2↔4, 6↔8, ..., 14↔34, ..., 30↔32).
RMAP_PAIRED_RELAY=1
# Set to 0 to exclude the final 30↔32 pair.
RMAP_PAIR_30_32=1
